# Copie este arquivo para .env.local e preencha.
# Número do WhatsApp da loja, só dígitos, com DDI e DDD (ex.: 5511999998888)
NEXT_PUBLIC_WHATSAPP=
# Endereço público do site (usado em SEO e links)
NEXT_PUBLIC_SITE_URL=https://ksjp.app
# Chave da API da Anthropic para a assistente virtual (crie em console.anthropic.com).
# Na Vercel: Settings > Environment Variables. Nunca cole a chave em chat nem no GitHub.
ANTHROPIC_API_KEY=
# Opcional: modelo da assistente. Padrão claude-opus-5-5. Mais barato: claude-haiku-5-5
ASSISTENTE_MODELO=
